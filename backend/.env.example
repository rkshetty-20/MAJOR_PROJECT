# AOD-IPS / FraudGuard — Backend Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env.

# Database connection string (SQLite default for local dev)
DATABASE_URL=sqlite:///./aod_ips.db

# Path to Suricata eve.json event log (optional; not needed for core SOC demo)
SURICATA_EVE_PATH=/var/log/suricata/eve.json

# OpenRouter AI Chatbot Configuration
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# HMAC evidence-integrity key — REQUIRED for backend startup
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
EVIDENCE_HMAC_KEY=your_random_64_hex_chars_here